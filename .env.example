# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID (администратор магазина).
# Узнать его можно, например, у бота @userinfobot
ADMIN_ID=

# Публичный URL мини-приложения (Railway выдаёт домен вида
# https://your-app.up.railway.app). Без слэша на конце.
WEBAPP_URL=

# Путь к файлу SQLite базы данных
DATABASE_URL=./data/expshop.db

# Порт, на котором слушает Express (Railway подставит свой автоматически,
# но переменную нужно оставить как fallback)
PORT=3000

# Курс: сколько гривен стоит 1 Robux
ROBUX_RATE_UAH=0.40

# Минимальный заказ, Robux
MIN_ORDER_ROBUX=500

# Наценка на выставление лота (1.25 = +25%)
LISTING_MARKUP=1.25

# Название магазина и юзернейм менеджера (без @)
SHOP_NAME=ExpShop
MANAGER_USERNAME=expshopgold
